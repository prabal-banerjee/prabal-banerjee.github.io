---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Publications from '../components/Publications.astro';
import Writings from '../components/Writings.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import '../styles/global.css';
---

<BaseLayout title="Prabal Banerjee">
  <div class="terminal-content">
    <Nav />
    <main>
      <Hero />
      <Publications />
      <Experience />
      <Education />
      <Contact />
      <Writings />
    </main>

    <footer class="site-footer">
      <span class="prompt">$</span> <a href="/about">about</a> · <a href="/privacy">privacy</a> ·
      <a href="/llms.txt">llms.txt</a> · <a href="/sitemap-index.xml">sitemap</a> ·
      <a href="https://github.com/prabal-banerjee/prabal-banerjee.github.io">source</a>
    </footer>
  </div>
</BaseLayout>

<style>
  .site-footer {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 60px) 48px;
    font-size: 0.75rem;
    color: var(--subtext);
  }

  .site-footer .prompt {
    color: var(--green);
  }
</style>

<script>
  // Scroll reveal + active nav highlighting
  const scrollRoot = document.querySelector('.terminal-content');
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.tab[data-section]');
  const reveals = document.querySelectorAll('.reveal');

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { root: scrollRoot, threshold: 0.1 }
  );

  reveals.forEach((el) => revealObserver.observe(el));

  const setActive = (id) => {
    navLinks.forEach((link) => {
      link.classList.toggle('active', link.dataset.section === id);
    });
  };

  if (scrollRoot && sections.length) {
    const sectionEls = Array.from(sections);
    const lastSection = sectionEls[sectionEls.length - 1];

    const updateActive = () => {
      const atBottom =
        scrollRoot.scrollTop + scrollRoot.clientHeight >=
        scrollRoot.scrollHeight - 2;
      if (atBottom) {
        setActive(lastSection.id);
        return;
      }
      // The active section is the last one whose top has scrolled past
      // ~40% of the scroll container's visible height.
      const threshold = scrollRoot.scrollTop + scrollRoot.clientHeight * 0.4;
      let current = sectionEls[0];
      for (const section of sectionEls) {
        if (section.offsetTop <= threshold) current = section;
        else break;
      }
      setActive(current.id);
    };

    updateActive();
    scrollRoot.addEventListener('scroll', updateActive, { passive: true });
    window.addEventListener('resize', updateActive);
  }
</script>
