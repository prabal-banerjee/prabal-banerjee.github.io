---
import BaseLayout from '../layouts/BaseLayout.astro';
import DocNav from '../components/DocNav.astro';
import '../styles/global.css';
---

<BaseLayout
  title="404 — Prabal Banerjee"
  description="That path does not exist on prabalbanerjee.xyz. Start from the home page, the sitemap, or llms.txt."
>
  <div class="terminal-content">
    <DocNav current="none" />

    <main>
      <section id="not-found" class="doc">
        <h1 class="sr-only">404 — page not found</h1>
        <div class="terminal-prompt-line" aria-hidden="true">$ cat &lt;requested path&gt;</div>

        <p class="err">bash: no such file or directory</p>

        <p>
          Nothing is published at this path. This site is small and entirely static, so there is a
          good chance the page you wanted never existed rather than having moved.
        </p>

        <h2>Where to go instead</h2>
        <ul>
          <li><a href="/">/</a> — home: publications, experience, education, contact, writings</li>
          <li><a href="/about">/about</a> — who I am and what I work on</li>
          <li><a href="/sitemap-index.xml">/sitemap-index.xml</a> — every page on this site</li>
          <li><a href="/llms.txt">/llms.txt</a> — a plain-text summary written for machine readers</li>
          <li><a href="/privacy">/privacy</a> — what this site collects</li>
        </ul>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .doc {
    max-width: 900px;
  }

  .doc p {
    color: var(--subtext);
    font-size: 0.85rem;
    line-height: 1.8;
    margin-bottom: 1.2rem;
    max-width: 72ch;
  }

  .doc p.err {
    color: var(--red);
  }

  .doc h2 {
    color: var(--mauve);
    font-size: 0.85rem;
    font-weight: 700;
    margin: 2rem 0 0.8rem;
  }

  .doc ul {
    list-style: none;
    color: var(--subtext);
    font-size: 0.85rem;
    line-height: 2;
  }
</style>
