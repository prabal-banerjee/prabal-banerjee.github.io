---
import projects from '../data/projects.json';
---

<section id="projects">
  <h2 class="terminal-prompt-line">$ ls projects/</h2>

  <div class="project-list">
    {projects.map((project, i) => (
      <div class={`project-entry entry-hover accent-mauve reveal reveal-delay-${(i % 4) + 1}`}>
        <h3 class="entry-title">
          <a href={project.url}>{project.title}</a>
        </h3>
        <p class="entry-sub">{project.blurb}</p>
        <p class="entry-meta">
          {project.meta}
          <span class="sep"> · </span>
          <a href={project.source}>source</a>
        </p>
      </div>
    ))}
  </div>
</section>

<style>
  .project-list {
    max-width: 900px;
  }

  .project-entry {
    margin-bottom: 0.25rem;
  }

  .entry-title {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 400;
    margin-bottom: 0.3rem;
    line-height: 1.5;
  }

  .entry-title a {
    color: var(--mauve);
  }

  .entry-sub {
    color: var(--subtext);
    font-size: 0.8rem;
    margin-bottom: 0.2rem;
    line-height: 1.5;
    max-width: 70ch;
  }

  .entry-meta {
    color: var(--green);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .entry-meta a {
    color: var(--green);
  }
</style>
