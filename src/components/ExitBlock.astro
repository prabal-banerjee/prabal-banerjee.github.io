<div class="exit-block reveal">
  <div class="exit-line">
    <span class="prompt">$</span>
    <span class="cmd">exit</span>
  </div>
  <div class="process-line">[Process completed]</div>
</div>

<style>
  .exit-block {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 60px);
    font-size: 0.9rem;
  }

  .prompt {
    color: var(--green);
    margin-right: 0.5rem;
  }

  .cmd {
    color: var(--peach);
  }

  .process-line {
    color: var(--subtext);
    font-size: 0.8rem;
    margin-top: 0.3rem;
  }
</style>
