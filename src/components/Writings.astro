---
import writings from '../data/writings.json';
---

<section id="writings">
  <div class="terminal-prompt-line">$ ls writings/</div>

  <div class="writing-list">
    {writings.map((post, i) => (
      <div class={`writing-entry entry-hover accent-mauve reveal reveal-delay-${(i % 4) + 1}`}>
        <h3 class="entry-title">
          <a href={post.url}>{post.title}</a>
        </h3>
        <p class="entry-sub">{post.blurb}</p>
        <p class="entry-meta">{post.date}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .writing-list {
    max-width: 900px;
  }

  .writing-entry {
    margin-bottom: 0.25rem;
  }

  .entry-title {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 400;
    margin-bottom: 0.3rem;
    line-height: 1.5;
  }

  .entry-title a {
    color: var(--mauve);
  }

  .entry-sub {
    color: var(--subtext);
    font-size: 0.8rem;
    margin-bottom: 0.2rem;
    line-height: 1.5;
    max-width: 70ch;
  }

  .entry-meta {
    color: var(--green);
    font-size: 0.8rem;
    line-height: 1.5;
  }
</style>
